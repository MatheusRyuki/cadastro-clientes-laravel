APP_NAME=Clientes
APP_ENV=e2e
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081
E2E_APP_PORT=8081
E2E_TOKEN=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=e2e
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_COOKIE=e2e-session
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_ROOT=/var/www/html/storage/app/e2e-public
FILESYSTEM_PUBLIC_PATH=/e2e-storage
MAIL_MAILER=array
LOG_CHANNEL=stderr
